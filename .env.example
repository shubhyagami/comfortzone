# NVIDIA NIM API Configuration - Get your key at https://build.nvidia.com
NVIDIA_API_KEY=your_nvidia_nim_api_key_here
SECRET_KEY=change-this-to-random-string
NVIDIA_MODEL=google/gemma-3n-e4b-it
